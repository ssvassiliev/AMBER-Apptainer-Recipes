Bootstrap: docker
From: nvidia/cuda:12.8.1-devel-ubuntu24.04

%files
    install-prefix.patch /opt/install-prefix.patch

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y \
        build-essential \
        gcc-12 \
        g++-12 \
        gfortran-12 \
        cmake \
        ninja-build \
        git \
        wget \
        curl \
        vim \
        pkg-config \
        ca-certificates \
        libssl-dev \
        libffi-dev \
        flex \
        bison \
        swig \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        netcdf-bin \
        libnetcdf-dev \
        python3-netcdf4 \
        doxygen

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/venv
    . /opt/venv/bin/activate

    pip install --upgrade pip setuptools wheel

    pip install numpy scipy cython tqdm h5py rich huggingface_hub typer
    pip install "typing_extensions>=4.0.0" h5py tqdm ninja typer \
    	rich ase pandas pyarrow "zarr<3" huggingface_hub

    # PyTorch with CUDA 12.8
    pip install torch==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

    # TorchANI + TorchANI-Amber
    git config --global --add \
        url."https://github.com/".insteadOf "git@github.com:"
    git config --global --add \
        url."https://github.com/".insteadOf "ssh://git@github.com/"

    git clone --recurse-submodules \
        https://github.com/roitberg-group/torchani-amber.git /opt/torchani-amber-src
    cd /opt/torchani-amber-src
    git checkout 1e06f3369f0b2e0fddd5e332b010c6a4638629a9
    git submodule update --init --recursive

    patch -p0 < /opt/install-prefix.patch
    rm /opt/install-prefix.patch

    export CC=gcc-12
    export CXX=g++-12
    export FC=gfortran-12
    export CUDAHOSTCXX=g++-12
    export CUDACXX=/usr/local/cuda/bin/nvcc
    export TORCH_CUDA_ARCH_LIST="8.0;9.0"

    TORCH_DIR=$(python -c \
        "import torch; print(torch.utils.cmake_prefix_path)")
    export CMAKE_PREFIX_PATH="$TORCH_DIR"

    rm -rf build
    pip install --no-deps --no-build-isolation -v \
    -e ./submodules/torchani_sandbox
    ani build-extensions
    ./run-cmake -T -b

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/venv/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

%runscript
    python - <<'EOF'
import torch
print("Torch:", torch.__version__)
print("CUDA:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())

import torchani
print("TorchANI:", torchani.__version__)
EOF
