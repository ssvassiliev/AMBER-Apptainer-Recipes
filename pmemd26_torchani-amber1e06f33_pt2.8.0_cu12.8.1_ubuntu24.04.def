Bootstrap: localimage
From: torchani-amber1e06f33_pt2.8.0_cu12.8.1_ubuntu24.04.sif

%labels
    Author          your.email@institution.ca
    Version         1.0
    Pmemd           26
    TorchANI-Amber  main (sm90, linked to pip torch 2.10.0/cu129)
    Base            Ubuntu 24.04
    Build           source (serial + MPI + cuda + NCCL)

%help
    Ubuntu 24.04 container with AmberTools 26 (pmemd) built from source,
    plus TorchANI-Amber for ANI-style ML potential dynamics.

    IMPORTANT: these files must be present next to this .def when building:
        pmemd26.tar.bz2        (https://ambermd.org/GetAmber.php, registration required)
        3rdPartyTools_NCCL.patch
        v2.10.1.tar.gz         (PLUMED source)
        cuda_arch-sm90.patch   (TorchANI-Amber sm90 patch)

        apptainer build pmemd26.sif pmemd26_torchani.def

    Tools included: pmemd, pmemd.MPI, pmemd.cuda, pmemd.cuda.MPI

    Usage:
        apptainer exec --nv pmemd26.sif pmemd.cuda -O -i mdin ...
        apptainer exec --nv pmemd26.sif mpirun -np 4 pmemd.cuda.MPI -O ...

    TorchANI-Amber full-ML usage: set iextpot=1 / &extpot / &ani in mdin as
    per https://github.com/roitberg-group/torchani-amber

    Interactive shell:
        apptainer shell pmemd26.sif

%files
    pmemd26.tar.bz2 /opt/pmemd26.tar.bz2
    3rdPartyTools_NCCL.patch /opt/3rdPartyTools_NCCL.patch
    CudaArch.patch /opt/CudaArch.patch
    find_torchani.patch /opt/find_torchani.patch
    v2.10.1.tar.gz /opt/v2.10.1.tar.gz

%post
    export DEBIAN_FRONTEND=noninteractive
    NPROC=$(nproc)
    AMBERHOME=/opt/amber26

    # ---------------------------------------------------------------
    # 1. System build dependencies
    # ---------------------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc-12 \
        g++-12 \
	gfortran \
        gfortran-12 \
        cmake \
        ninja-build \
        make \
        git \
        wget \
        curl \
        vim \
        pkg-config \
        ca-certificates \
        libssl-dev \
        libffi-dev \
        flex \
        bison \
        swig \
        patch \
        tcsh \
        zlib1g-dev \
        libbz2-dev \
        libboost-dev \
        libarpack2-dev \
        libgsl-dev \
        liblapack-dev \
        libblas-dev \
        libfftw3-dev \
        libopenmpi-dev \
        openmpi-bin \
        libnetcdf-dev \
        libnetcdff-dev \
        netcdf-bin \
        libhdf5-dev \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-netcdf4 \
	python3-tk \
        doxygen
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # ---------------------------------------------------------------
    # 2. PLUMED (standalone -- not linked into the pmemd/torchani cmake
    #    builds below, matches the original recipe's setup)
    # ---------------------------------------------------------------
    #export CC=gcc-12
    #export CXX=g++-12
    #cd /opt
    #tar xf v2.10.1.tar.gz
    #rm /opt/v2.10.1.tar.gz
    #cd plumed2-2.10.1
    #./configure
    #make -j"$NPROC"
    #make install
    #rm -rf /opt/plumed2-2.10.1

    export CC=gcc-12
    export CXX=g++-12
    export FC=gfortran-12
    export CUDAHOSTCXX=g++-12
    export CUDACXX=/usr/local/cuda/bin/nvcc
    export PATH=/opt/venv/bin:$PATH
   
    pip install numba gemmi Bio freesasa scikit-learn pydantic psutil fastapi
    # ---------------------------------------------------------------
    # 4. PMEMD26 (MPI + CUDA + NCCL)
    # ---------------------------------------------------------------
    mkdir -p /opt/pmemd26_src
    cd /opt
    tar xjf /opt/pmemd26.tar.bz2 --strip-components=1 -C /opt/pmemd26_src
    rm /opt/pmemd26.tar.bz2
    cd /opt/pmemd26_src
    sed -i '/set(INSIDE_AMBER TRUE)/a add_compile_definitions(THRUST_IGNORE_CUB_VERSION_CHECK)' CMakeLists.txt
    patch -p0 < /opt/3rdPartyTools_NCCL.patch
    patch -p0 < /opt/CudaArch.patch
    patch -p0 < /opt/find_torchani.patch
    rm /opt/3rdPartyTools_NCCL.patch /opt/CudaArch.patch /opt/find_torchani.patch

    mkdir -p /opt/pmemd26_src/build_mpi
    cd /opt/pmemd26_src/build_mpi

    export CUDNN_INCLUDE_PATH=/opt/venv/lib/python3.12/site-packages/nvidia/cudnn/include 
    export CUDNN_LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/nvidia/cudnn/lib 

    export NCCL_HOME=/usr
    ln -sf /usr/lib/x86_64-linux-gnu/libnccl.so /usr/lib/libnccl.so
    ln -sf /usr/lib/x86_64-linux-gnu/libnccl.so.2 /usr/lib/libnccl.so.2
    ldconfig

    cmake .. \
        -DCMAKE_INSTALL_PREFIX=${AMBERHOME} \
        -DPMEMD_ONLY=TRUE \
        -DCOMPILER=GNU \
        -DMPI=TRUE \
        -DOPENMP=FALSE \
        -DCUDA=FALSE \
        -DNCCL=TRUE \
        -DPYTHON_EXECUTABLE=/opt/venv/bin/python \
        -DINSTALL_TESTS=FALSE \
        -DCHECK_UPDATES=FALSE \
	-DLIBTORCH=FALSE \
        -DCMAKE_PREFIX_PATH="/opt/torchani-amber" \
	-Dtorchani_ENABLED=ON 

    make VERBOSE=1 -j"$NPROC" install
    make clean
    cd /opt/pmemd26_src && rm -rf build_mpi

    # ---------------------------------------------------------------
    # 5. Cleanup
    # ---------------------------------------------------------------
    cd /opt && rm -rf /opt/pmemd26_src

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    export AMBERHOME=/opt/amber26
    export PATH=${AMBERHOME}/bin:/opt/venv/bin:$PATH
    export LD_LIBRARY_PATH=${AMBERHOME}/lib:/usr/local/cuda/lib64:$LD_LIBRARY_PATH

    # TorchANI-Amber -- libs live under lib/Torchani/, confirmed via
    # IMPORTED_LOCATION_RELEASE in TorchaniTargets-release.cmake
    export LD_LIBRARY_PATH=/opt/torchani-amber/lib/Torchani:$LD_LIBRARY_PATH

%runscript
    #!/bin/bash
    . /opt/amber26/amber.sh 2>/dev/null || true
    if [ "$#" -eq 0 ]; then
        python - <<'EOF'
import torch
print("Torch:", torch.__version__)
print("CUDA:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
import torchani
print("TorchANI:", torchani.__version__)
EOF
    else
        exec "$@"
    fi

#%test
#    . /opt/amber26/amber.sh
#    echo "=== AMBERHOME: ${AMBERHOME} ==="
#    pmemd.cuda --version 2>&1 | head -3
#    echo "=== MPI build ==="
#    pmemd.cuda.MPI --version 2>&1 | head -3
#    echo "=== TorchANI-Amber ==="
#    python -c "import torch, torchani; print(torch.__version__, torchani.__version__)"
#    echo "=== Test passed ==="
